<policies>
  <inbound>
    <base />
    
    <!-- Securely fetch the Named Value containing the SAS URL -->
    <set-variable name="fullBackendUrl" value="{{logicAppBackendUrl}}" />

    <!-- Safely parse it using native C# without string interpolation bugs -->
    <set-variable name="logicAppBaseUrl" value='@{
        var url = new Uri((string)context.Variables["fullBackendUrl"]);
        return url.Scheme + "://" + url.Host;
    }' />
    <set-variable name="logicAppPathAndQuery" value='@{
        var url = new Uri((string)context.Variables["fullBackendUrl"]);
        return url.PathAndQuery;
    }' />

    <!-- Forward to Logic App webhook -->
    <set-backend-service base-url='@((string)context.Variables["logicAppBaseUrl"])' />
    <rewrite-uri template='@((string)context.Variables["logicAppPathAndQuery"])' />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
